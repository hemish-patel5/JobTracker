{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend/frontend run build",
  "installCommand": "npm --prefix frontend/frontend ci",
  "outputDirectory": "frontend/frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
