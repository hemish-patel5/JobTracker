# PostgreSQL / Neon (use the pooled endpoint for the running application)
DB_URL=jdbc:postgresql://your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# Google Gmail OAuth
GOOGLE_GMAIL_CLIENT_ID=your_google_client_id
GOOGLE_GMAIL_CLIENT_SECRET=your_google_client_secret
GOOGLE_GMAIL_REDIRECT_URI=https://your-render-service.onrender.com/api/gmail/oauth2/callback

# Deployed Vercel origin used for redirects and CORS (no trailing slash)
FRONTEND_URL=https://your-project.vercel.app

# ntfy topic name; use a long, private, difficult-to-guess value
NTFY_TOPIC=your_private_ntfy_topic

# Shared secret required in the X-Scheduler-Secret cron request header
SCHEDULER_SECRET=replace_with_a_long_random_secret

# Optional local/runtime overrides. Render supplies PORT automatically.
PORT=8080
SHOW_SQL=false
